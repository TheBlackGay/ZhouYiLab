        ["丑月", "癸"], ["辰月", "乙"], ["未月", "丁"], ["戌月", "辛"],
        ["寅月", "艮"], ["巳月", "巽"], ["申月", "坤"], ["亥月", "乾"]
      ]
    },
    "current": {
      "description": "现行月令口诀",
      "pairs": [
        ["正月", "丁"], ["二月", "申"], ["三月", "壬"], ["四月", "辛"],
