{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bazi-case/1.0",
  "title": "八字校准命例（D3：子平格局主线）",
  "description": "一条命例 = 输入 + 盘面事实期望 + 定性判断期望 + 来源。定性判断边界先行，量化最后；盲派做功不做模拟（平台边界）。judgment 字段是校准目标，facts 字段是排盘回归。",
  "type": "object",
  "required": [
    "id",
    "enabled",
    "input",
    "expected_facts",
    "provenance",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "enabled": {
      "type": "boolean"
    },
    "input": {
      "type": "object",
      "required": [
        "calendar",
        "date"
      ],
      "properties": {
        "calendar": {
          "enum": [
            "solar",
            "lunar"
          ]
        },
        "date": {
          "type": "object",
          "required": [
            "year",
            "month",
            "day",
            "hour"
          ]
        },
        "time_correction": {
          "type": "object"
        },
        "gender": {
          "enum": [
            "male",
            "female"
          ]
        }
      }
    },
    "expected_facts": {
      "type": "object",
      "description": "排盘事实断言（四柱/十神/藏干/旬空/纳音/大运等，键与 CLI 输出对齐）",
      "properties": {
        "pillars": {
          "type": "object"
        }
      }
    },
    "judgment": {
      "type": "object",
      "description": "子平格局定性期望（第一步校准时允许缺省）",
      "properties": {
        "yueling": {
          "type": "string",
          "description": "月令得失与司令"
        },
        "geju": {
          "type": "string",
          "description": "格局名（成格/败格倾向）"
        },
        "gen_qiang": {
          "enum": [
            "强根",
            "中根",
            "微根",
            "无根"
          ]
        },
        "day_master": {
          "enum": [
            "偏强",
            "中和",
            "偏弱"
          ],
          "description": "定性档位，不打分"
        },
        "yongshen": {
          "type": "object",
          "description": "扶抑/调候候选与优先级（第二步）"
        },
        "decision_trace": {
          "type": "array",
          "description": "月令→根气→干势→刑冲合会 的可追溯决策记录"
        }
      }
    },
    "provenance": {
      "allOf": [
        {
          "$ref": "zhouyilab-source-ref/1.0"
        }
      ],
      "description": "命例出处（书名+版本+批注者可选）"
    },
    "status": {
      "enum": [
        "pending",
        "verified",
        "failed"
      ]
    },
    "annotator": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
