      "required_context": {
        "relation": "same_palace",
        "same_source_layer": true
      },
      "elemental_mechanism": {
        "relation": "controls",
        "direction": "lianzhen -> qisha",
        "description": "廉贞的边界、规则与投入强度约束七杀的果断、高压和独立行动，使原本直接的行动能量更可能进入纪律、责任和可管理的路径。",
        "boundary": "五行相克只描述可能的约束方向，不自动代表有效控制、权力、财富或成格；亮度、四化及其他组合可能使约束稳定，也可能使双方形成压制和冲突。"
      },
      "base_hypotheses": [
        {
          "dimension_id": "authority_influence",
          "direction": "context_dependent",
          "rationale": "规则约束果断行动可能转化为纪律和责任，也可能只有控制而缺乏合法授权。",
          "evidence_level": "E5",
          "parameter_status": "proposed"
        },
        {
          "dimension_id": "execution_action",
          "direction": "increase",
          "rationale": "廉贞的持续投入与七杀的快速决断共同指向更强的行动推进。",
          "evidence_level": "E5",
          "parameter_status": "proposed"
        },
        {
          "dimension_id": "stability_accumulation",
          "direction": "context_dependent",
          "rationale": "规则可能使高压行动形成可积累成果，但若控制失衡也可能损害结构延续。",
          "evidence_level": "E5",
          "parameter_status": "proposed"
        },
        {
          "dimension_id": "conflict_risk",
          "direction": "context_dependent",
          "rationale": "有效约束可能降低冒进风险，压制失衡则可能提高对抗和损耗。",
          "evidence_level": "E5",
          "parameter_status": "proposed"
        }
      ],
