              "evidence_level": "E5",
              "parameter_status": "proposed"
            },
            {
              "dimension_id": "conflict_risk",
              "direction": "decrease",
              "rationale": "较充分且稳定的表达被假设能够减少约束与行动之间的失配；仍需盲评验证。",
              "evidence_level": "E5",
