  "default_grade": "普通格局",
  "status_policy": {"required_matched": "formed", "enhancer_matched": "strengthened"},
  "result": {"nature": "auspicious_with_outcome_split", "summary": "严格按卯酉命紫微贪狼同守；空劫同宫或六煞会聚标记僧道倾向，无重煞且吉化、左右魁钺达标升贵格。", "interpretation_template": "{effect_palace}命中极居卯酉格，档位为{grade}。本结果只确认给定文本结构，不把古代断语转换为现实结果保证。"},
  "examples": [
