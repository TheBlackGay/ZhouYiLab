  ],
  "ordinary_palace_observations": [{"id": "body_ji_ju_note", "name": "身宫卯酉紫贪相似结构", "all": [{"id": "body_ji_ju_role", "predicate": "focus.role_in", "values": ["body"]}, {"id": "body_ji_ju_branch", "predicate": "focus.branch_in", "values": ["卯", "酉"]}, {"id": "body_ji_ju_same", "predicate": "star.same_palace", "scope": "self", "values": ["紫微", "贪狼"], "source_layer": "$current_layer"}], "note_template": "{focus_palace}为身宫且卯酉紫微贪狼同守；原文只论命宫，不触发极居卯酉格"}],
  "allow_role_observations": true,
