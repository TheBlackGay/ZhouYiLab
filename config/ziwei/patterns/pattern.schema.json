{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhouyilab.local/schema/ziwei-pattern-1.1.0.json",
  "title": "ZhouYiLab 紫微斗数格局规则",
  "type": "object",
  "required": [
    "schema_version", "id", "revision", "enabled", "name", "category",
    "school", "strictness", "applicable_layers", "applicable_focus_palaces",
    "required", "status_policy", "result", "examples"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "id": {"type": "string", "pattern": "^pattern\\."},
    "revision": {"type": "integer", "minimum": 1},
    "enabled": {"type": "boolean"},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "school": {"type": "string", "minLength": 1},
    "strictness": {"enum": ["baseline", "strict"]},
    "applicable_layers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "applicable_focus_palaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required": {"type": "object"},
    "tendency_conditions": {"type": "object"},
    "enhancers": {"type": "array", "items": {"type": "object"}},
    "weakeners": {"type": "array", "items": {"type": "object"}},
    "breakers": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "items": {"type": "object"}},
    "ordinary_palace_observations": {"type": "array", "items": {"type": "object"}},
    "snapshot_stars": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_flags": {"type": "object", "additionalProperties": {"type": "string"}},
    "output_values": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["condition_id"], "properties": {"condition_id": {"type": "string"}, "path": {"type": "string"}}, "additionalProperties": false}]}},
    "output_star_positions": {"type": "object", "additionalProperties": {"type": "string"}},
    "break_check": {
      "type": "object",
      "required": ["break_star", "scan_scope", "note"],
      "properties": {
        "break_star": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "scan_scope": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "grade_by_variant": {"type": "object", "additionalProperties": {"type": "string"}},
    "default_grade": {"type": "string", "minLength": 1},
    "grade_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["grade", "when"],
        "properties": {
          "grade": {"type": "string", "minLength": 1},
          "when": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "allow_role_observations": {"type": "boolean"},
    "textual_variants": {"type": "array", "items": {"type": "object"}},
    "status_policy": {"type": "object"},
    "required_variant_policy": {
      "type": "object",
      "required": ["minimum_matches", "status"],
      "properties": {
        "minimum_matches": {"type": "integer", "minimum": 2},
        "status": {"type": "string", "enum": ["formed", "strengthened", "weakened", "broken", "tendency"]}
      },
      "additionalProperties": false
    },
    "result": {"type": "object"},
    "examples": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
